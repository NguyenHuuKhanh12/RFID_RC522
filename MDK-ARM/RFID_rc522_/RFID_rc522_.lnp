--cpu Cortex-M3
"rfid_rc522_\startup_stm32f103xb.o"
"rfid_rc522_\main.o"
"rfid_rc522_\stm32f1xx_it.o"
"rfid_rc522_\stm32f1xx_hal_msp.o"
"rfid_rc522_\stm32f1xx_hal_gpio_ex.o"
"rfid_rc522_\stm32f1xx_hal_i2c.o"
"rfid_rc522_\stm32f1xx_hal.o"
"rfid_rc522_\stm32f1xx_hal_rcc.o"
"rfid_rc522_\stm32f1xx_hal_rcc_ex.o"
"rfid_rc522_\stm32f1xx_hal_gpio.o"
"rfid_rc522_\stm32f1xx_hal_dma.o"
"rfid_rc522_\stm32f1xx_hal_cortex.o"
"rfid_rc522_\stm32f1xx_hal_pwr.o"
"rfid_rc522_\stm32f1xx_hal_flash.o"
"rfid_rc522_\stm32f1xx_hal_flash_ex.o"
"rfid_rc522_\stm32f1xx_hal_exti.o"
"rfid_rc522_\stm32f1xx_hal_rtc.o"
"rfid_rc522_\stm32f1xx_hal_rtc_ex.o"
"rfid_rc522_\stm32f1xx_hal_spi.o"
"rfid_rc522_\stm32f1xx_hal_uart.o"
"rfid_rc522_\system_stm32f1xx.o"
--strict --scatter "RFID_rc522_\RFID_rc522_.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "RFID_rc522_.map" -o RFID_rc522_\RFID_rc522_.axf